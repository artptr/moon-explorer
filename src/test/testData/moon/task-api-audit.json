{
  "command": "echo",
  "args": [
    "audit"
  ],
  "description": "Do a check of the dependencies for known vulnerabilities.",
  "id": "audit",
  "inputs": [
    {
      "glob": "**/*",
      "cache": true
    },
    {
      "glob": "/.moon/{extensions,toolchains}.{yml,yaml,jsonc,json,pkl,hcl,toml}",
      "cache": true
    },
    {
      "file": "/.moon/tasks/backend.yml"
    }
  ],
  "inputFiles": {
    ".moon/tasks/backend.yml": {}
  },
  "inputGlobs": {
    ".moon/{extensions,toolchains}.{yml,yaml,jsonc,json,pkl,hcl,toml}": {
      "cache": true
    },
    "apps/api/**/*": {
      "cache": true
    }
  },
  "options": {
    "allowFailure": false,
    "cache": true,
    "envOverride": false,
    "expectFailure": false,
    "inferInputs": false,
    "internal": false,
    "interactive": false,
    "mergeArgs": "append",
    "mergeChecks": "append",
    "mergeDeps": "append",
    "mergeEnv": "append",
    "mergeInputs": "append",
    "mergeOutputs": "append",
    "mergeTags": "append",
    "mergeToolchains": "append",
    "persistent": false,
    "priority": "normal",
    "retryCount": 0,
    "runDepsInParallel": true,
    "runInCI": true,
    "runInSyncPhase": false,
    "runFromWorkspaceRoot": false,
    "shell": true,
    "unixShell": "bash",
    "windowsShell": "pwsh"
  },
  "state": {
    "defaultInputs": true,
    "expanded": true
  },
  "target": "api:audit",
  "toolchains": [
    "system"
  ],
  "type": "test"
}
