{
  "command": "echo",
  "args": [
    "build",
    "web"
  ],
  "deps": [
    {
      "args": [],
      "env": {},
      "target": "ui:build",
      "cacheStrategy": "hash"
    },
    {
      "args": [],
      "env": {},
      "target": "utils:build",
      "cacheStrategy": "hash"
    }
  ],
  "description": "Make the production bundle.",
  "id": "build",
  "inputs": [
    {
      "glob": "**/*",
      "cache": true
    },
    {
      "glob": "/.moon/{extensions,toolchains}.{yml,yaml,jsonc,json,pkl,hcl,toml}",
      "cache": true
    }
  ],
  "inputGlobs": {
    ".moon/{extensions,toolchains}.{yml,yaml,jsonc,json,pkl,hcl,toml}": {
      "cache": true
    },
    "apps/web/**/*": {
      "cache": true
    }
  },
  "options": {
    "allowFailure": false,
    "cache": true,
    "envOverride": false,
    "expectFailure": false,
    "inferInputs": false,
    "internal": false,
    "interactive": false,
    "mergeArgs": "append",
    "mergeChecks": "append",
    "mergeDeps": "append",
    "mergeEnv": "append",
    "mergeInputs": "append",
    "mergeOutputs": "append",
    "mergeTags": "append",
    "mergeToolchains": "append",
    "persistent": false,
    "priority": "normal",
    "retryCount": 0,
    "runDepsInParallel": true,
    "runInCI": true,
    "runInSyncPhase": false,
    "runFromWorkspaceRoot": false,
    "shell": true,
    "unixShell": "bash",
    "windowsShell": "pwsh"
  },
  "outputs": [
    {
      "file": "dist",
      "optional": true
    }
  ],
  "outputFiles": {
    "apps/web/dist": {
      "optional": true
    }
  },
  "state": {
    "defaultInputs": true,
    "expanded": true
  },
  "target": "web:build",
  "toolchains": [
    "system"
  ],
  "type": "build"
}
