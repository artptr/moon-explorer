<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>io.github.artptr.moonexplorer</id>
    <name>Moon Explorer</name>
    <vendor url="https://github.com/artptr/moon-explorer">Artem Petrenkov</vendor>
    <description><![CDATA[
        <p><b>Moon Explorer is a full IDE companion for <a href="https://moonrepo.dev">moon</a> workspaces in IntelliJ IDEA, WebStorm, and every other IntelliJ-based JetBrains IDE.</b></p>
        <p>Browse every project and task in your monorepo, run any of them in a couple of keystrokes, and edit <code>moon.yml</code> and <code>.moon/tasks/</code> knowing exactly which projects each change will touch. No terminal, no digging through YAML, no global installation of moon.</p>

        <h3>Explore the workspace</h3>
        <ul>
            <li>A <b>Moon</b> tool window with every project and task of the workspace</li>
            <li>Group by project or by task name, optionally inside <code>stack</code>, <code>layer</code>, or tag nodes</li>
            <li>Type to search task IDs, project IDs, and task descriptions</li>
            <li><b>Jump to Source</b> opens the configuration file of a task, at the line of the task in YAML files, including tasks inherited from <code>.moon/tasks/</code></li>
            <li>Automatic refresh about a second after you change a project configuration file or a configuration file in <code>.moon/</code></li>
        </ul>

        <h3>Run tasks from anywhere</h3>
        <ul>
            <li>Double-click a task in the tree, or select several tasks and run them in one <code>moon run</code></li>
            <li><b>Run in N Projects</b> and <b>Run Affected in N Projects</b> on a task name</li>
            <li>Find and run tasks in <b>Search Everywhere</b>, or type <code>moon</code> in <b>Run Anything</b> for target completion and any moon command. The <b>Execute Moon Task</b> toolbar button opens it for you.</li>
            <li>Run icons in the gutter of <code>moon.yml</code> and of the files in <code>.moon/tasks/</code></li>
            <li>Standard IDE run configurations with several targets, <code>--affected</code>, <code>--force</code>, pass-through arguments, and environment variables</li>
        </ul>

        <h3>Understand task inheritance</h3>
        <ul>
            <li>Code Vision hints in <code>.moon/tasks/</code>: <b>Inherited by N projects</b>, <b>Merged in N projects</b>, and <b>N dependents</b></li>
            <li>Hints in <code>moon.yml</code>: <b>N inherited tasks</b> and <b>Merged with &lt;global file name&gt;</b>, with gutter icons that jump to the global task</li>
            <li>Completion, <b>Go to Declaration</b>, and an inspection with a quick fix for <code>workspace.inheritedTasks</code></li>
            <li>A <b>Moon</b> file type for <code>moon.yml</code> and <code>moon.yaml</code>. The existing JSON schema support is unaffected.</li>
        </ul>

        <h3>Works with your setup</h3>
        <ul>
            <li>Finds moon automatically in <code>node_modules/.bin/</code>, in proto, or on <code>PATH</code></li>
            <li>Uses only the IntelliJ Platform. The editor features work with YAML configuration files and need the YAML plugin that comes bundled with the IDE.</li>
            <li>Requires moon v2. Works offline and sends no telemetry.</li>
        </ul>

        <p><a href="https://github.com/artptr/moon-explorer#readme">Documentation</a> | <a href="https://github.com/artptr/moon-explorer/issues">Issues</a></p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <!-- This dependency gives the run icons in the YAML configuration files and the file type of moon.yml and moon.yaml. Refer to docs/adr/0004-yaml-plugin-optional-dependency.md and docs/adr/0005-yaml-file-type-and-task-hints.md. -->
    <depends optional="true" config-file="moon-explorer-yaml.xml">org.jetbrains.plugins.yaml</depends>

    <resource-bundle>messages.MoonExplorerBundle</resource-bundle>

    <extensionPoints>
        <!-- A converter gives the structure of a configuration file in one format. Refer to docs/adr/0005-yaml-file-type-and-task-hints.md. -->
        <extensionPoint name="configConverter" beanClass="com.intellij.lang.LanguageExtensionPoint" dynamic="true">
            <with attribute="implementationClass" implements="io.github.artptr.moonexplorer.config.ConfigConverter"/>
        </extensionPoint>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Moon"
                    anchor="right"
                    icon="io.github.artptr.moonexplorer.MoonIcons.ToolWindow"
                    factoryClass="io.github.artptr.moonexplorer.ui.MoonToolWindowFactory"/>
        <postStartupActivity implementation="io.github.artptr.moonexplorer.model.MoonTasksStartupActivity"/>
        <postStartupActivity implementation="io.github.artptr.moonexplorer.ui.UiServicesStartupActivity"/>
        <notificationGroup id="Moon Explorer" displayType="STICKY_BALLOON" key="notification.group.name"/>
        <notificationGroup id="Moon Explorer commands" displayType="BALLOON" key="notification.commands.group.name"/>
        <projectConfigurable parentId="tools"
                             id="io.github.artptr.moonexplorer.settings"
                             instance="io.github.artptr.moonexplorer.settings.MoonSettingsConfigurable"
                             key="settings.displayName"/>
        <configurationType implementation="io.github.artptr.moonexplorer.run.MoonRunConfigurationType"/>
        <searchEverywhereContributor implementation="io.github.artptr.moonexplorer.ui.MoonTaskSearchContributor$Factory"/>
        <runAnything.executionProvider implementation="io.github.artptr.moonexplorer.ui.MoonRunAnythingProvider"/>
        <dependencySupport kind="javascript" coordinate="npm:@moonrepo/cli" displayName="moon"/>
        <codeInsight.daemonBoundCodeVisionProvider implementation="io.github.artptr.moonexplorer.config.MoonInheritedCodeVisionProvider"/>
        <codeInsight.daemonBoundCodeVisionProvider implementation="io.github.artptr.moonexplorer.config.MoonMergedCodeVisionProvider"/>
        <codeInsight.daemonBoundCodeVisionProvider implementation="io.github.artptr.moonexplorer.config.MoonDependentsCodeVisionProvider"/>
        <gotoDeclarationHandler implementation="io.github.artptr.moonexplorer.config.MoonInheritedTasksGotoDeclarationHandler"/>
        <config.codeVisionGroupSettingProvider implementation="io.github.artptr.moonexplorer.config.MoonCodeVisionGroupSettingProvider"/>
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>
    </extensions>

    <projectListeners>
        <listener class="io.github.artptr.moonexplorer.model.MoonConfigFileListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>

    <actions>
        <group id="MoonExplorer.TasksToolbar">
            <action id="MoonExplorer.RefreshTasks"
                    class="io.github.artptr.moonexplorer.ui.RefreshTasksAction"
                    icon="AllIcons.Actions.Refresh"/>
            <action id="MoonExplorer.ExecuteMoonTask"
                    class="io.github.artptr.moonexplorer.ui.ExecuteMoonTaskAction"
                    icon="AllIcons.Actions.RunAnything"/>
            <action id="MoonExplorer.ShowRefreshFailure"
                    class="io.github.artptr.moonexplorer.ui.ShowRefreshFailureAction"
                    icon="AllIcons.General.Warning"/>
            <action id="MoonExplorer.SelectOpenedFile"
                    class="io.github.artptr.moonexplorer.ui.SelectOpenedFileAction"
                    icon="AllIcons.General.Locate"/>
            <group id="MoonExplorer.GroupBy" popup="true" icon="AllIcons.Actions.GroupBy">
                <action id="MoonExplorer.GroupByProject"
                        class="io.github.artptr.moonexplorer.ui.GroupByProjectAction"/>
                <action id="MoonExplorer.GroupByTaskName"
                        class="io.github.artptr.moonexplorer.ui.GroupByTaskNameAction"/>
                <separator/>
                <action id="MoonExplorer.CategoryNone"
                        class="io.github.artptr.moonexplorer.ui.CategoryNoneAction"/>
                <action id="MoonExplorer.CategoryStack"
                        class="io.github.artptr.moonexplorer.ui.CategoryStackAction"/>
                <action id="MoonExplorer.CategoryLayer"
                        class="io.github.artptr.moonexplorer.ui.CategoryLayerAction"/>
                <action id="MoonExplorer.CategoryTag"
                        class="io.github.artptr.moonexplorer.ui.CategoryTagAction"/>
            </group>
            <separator/>
            <action id="MoonExplorer.OpenSettings"
                    class="io.github.artptr.moonexplorer.ui.OpenMoonSettingsAction"
                    icon="AllIcons.General.Settings"/>
        </group>
        <group id="MoonExplorer.TaskPopup">
            <action id="MoonExplorer.RunTask"
                    class="io.github.artptr.moonexplorer.ui.RunTaskAction"
                    icon="AllIcons.Actions.Execute"/>
            <action id="MoonExplorer.RunInProjects"
                    class="io.github.artptr.moonexplorer.ui.RunInProjectsAction"
                    icon="AllIcons.Actions.Execute"/>
            <action id="MoonExplorer.RunAffectedInProjects"
                    class="io.github.artptr.moonexplorer.ui.RunAffectedInProjectsAction"
                    icon="AllIcons.Actions.Execute"/>
            <action id="MoonExplorer.RunSelectedTasks"
                    class="io.github.artptr.moonexplorer.ui.RunSelectedTasksAction"
                    icon="AllIcons.Actions.Execute"/>
            <action id="MoonExplorer.EditTaskSettings"
                    class="io.github.artptr.moonexplorer.ui.EditTaskSettingsAction"/>
            <separator/>
            <action id="MoonExplorer.JumpToSource"
                    class="io.github.artptr.moonexplorer.ui.JumpToSourceAction"
                    icon="AllIcons.Actions.EditSource"
                    use-shortcut-of="EditSource"/>
        </group>
    </actions>
</idea-plugin>
