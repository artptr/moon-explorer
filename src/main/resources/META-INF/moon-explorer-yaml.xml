<!-- This file registers the extensions that use the YAML PSI. The IDE loads this file only when the YAML plugin is active. -->
<!-- Refer to docs/adr/0004-yaml-plugin-optional-dependency.md and docs/adr/0005-yaml-file-type-and-task-hints.md. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Moon"
                  implementationClass="io.github.artptr.moonexplorer.yaml.MoonFileType"
                  fieldName="INSTANCE"
                  fileNames="moon.yml;moon.yaml"/>
        <runLineMarkerContributor language="yaml"
                                  implementationClass="io.github.artptr.moonexplorer.yaml.MoonTaskRunLineMarkerContributor"/>
        <codeInsight.lineMarkerProvider language="yaml"
                                        implementationClass="io.github.artptr.moonexplorer.config.MoonInheritanceLineMarkerProvider"/>
        <runConfigurationProducer implementation="io.github.artptr.moonexplorer.yaml.MoonTaskRunConfigurationProducer"/>
    </extensions>
    <extensions defaultExtensionNs="io.github.artptr.moonexplorer">
        <configConverter language="yaml" implementationClass="io.github.artptr.moonexplorer.yaml.YamlConfigConverter"/>
    </extensions>
</idea-plugin>
