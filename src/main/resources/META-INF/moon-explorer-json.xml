<!-- This file registers the JSON schema provider for the moon configuration files. The IDE loads this file only when the JSON plugin is active. -->
<!-- Refer to docs/adr/0006-json-schema-provider.md. -->
<idea-plugin>
    <extensions defaultExtensionNs="JavaScript">
        <JsonSchema.ProviderFactory implementation="io.github.artptr.moonexplorer.json.MoonJsonSchemaProviderFactory"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="io.github.artptr.moonexplorer.schema.MoonSchemaStartupActivity"/>
    </extensions>
    <projectListeners>
        <listener class="io.github.artptr.moonexplorer.json.MoonSchemaResetter"
                  topic="io.github.artptr.moonexplorer.schema.MoonSchemaListener"/>
    </projectListeners>
</idea-plugin>
